+			registry.noteResumeTurn(spawn.turnId);
 		}
 		return [];
 	}
@@ -165,7 +166,7 @@ export function buildTopLevelSubagentReadyAction(
 	const agentName = typeof input?.subagent_type === 'string' ? input.subagent_type : undefined;
