 .../node/claude/claudeSubagentRegistry.ts     | 25 ++++++++++++
 .../node/claude/claudeSubagentSignals.ts      |  3 +-
 .../agentHost/test/node/claudeAgent.test.ts   | 40 +++++++++++++++++++
 .../test/node/claudeSubagentSignals.test.ts   | 35 ++++++++++++++++
