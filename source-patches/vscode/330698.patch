From 8784f4ac211d9cb27c1a1f86b004246c224b92ad Mon Sep 17 00:00:00 2001
From: Ryan Ewen <ryan.ewen@gmail.com>
Date: Thu, 20 Aug 2026 22:10:09 -0400
Subject: [PATCH 4/4] Wait for the subprocess to exit before deleting the
 transcript

Aborting only signals the SDK subprocess. Disposing without waiting for
it left a window where the dying process could perform its final flush
after deleteSession had removed the JSONL, recreating the file this
change exists to remove. _removeAllTurns already awaits
shutdownLiveQuery for the same reason, so do the same here.
---
 src/vs/platform/agentHost/node/claude/claudeAgent.ts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/vs/platform/agentHost/node/claude/claudeAgent.ts b/src/vs/platform/agentHost/node/claude/claudeAgent.ts
index 4ab0fe806a132..fcbc86401396c 100644
--- a/src/vs/platform/agentHost/node/claude/claudeAgent.ts
+++ b/src/vs/platform/agentHost/node/claude/claudeAgent.ts
@@ -1317,6 +1317,8 @@ export class ClaudeAgent extends Disposable implements IAgent {
 		} else {
 			session.abort();
 		}
+		// Wait for the subprocess to exit so its flush cannot recreate the transcript.
+		await session.shutdownLiveQuery();
 		this._deleteSession(session);
 	}
 
