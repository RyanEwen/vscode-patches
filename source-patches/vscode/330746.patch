+			chat: this._chatChannelUri,
+			toolCallId: toolUseId,
+			toolName,
+			toolInput: JSON.stringify(args ?? {}),
+			...(parentToolCallId !== undefined ? { parentToolCallId } : {}),
+		}));
+	}
