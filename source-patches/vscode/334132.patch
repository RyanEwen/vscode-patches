 .../node/claude/claudeSubagentResolver.ts     |  2 +-
 .../test/node/claudeSubagentRegistry.test.ts  | 23 +++++++++
 .../test/node/claudeSubagentSignals.test.ts   | 25 ++++++++++
 4 files changed, 84 insertions(+), 15 deletions(-)

