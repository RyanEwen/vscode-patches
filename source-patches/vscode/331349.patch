From 297a233406c1edabedca50dac0996d4e10f050cb Mon Sep 17 00:00:00 2001
From: Ryan Ewen <ryan.ewen@gmail.com>
Date: Mon, 17 Aug 2026 17:43:22 -0400
Subject: [PATCH 1/4] Match a remote host's working directories against the
 window's folder
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

An agent host reports working directories as paths on the machine it runs on,
so a host in a dev container reports file: while the window's folder for the
same directory is vscode-remote:. isEqualOrParent compares schemes before
anything else, so the two never match however identical their paths, and every
session on the workspace folder is filtered out of the list.

A file: directory is now reinterpreted in the folder's namespace before the
containment check, and only when the folder has an authority — a local window
compares file: to file: and is untouched, and an already-remote directory is
left alone so a different authority still cannot match.

The sessions being matched all come from the store's single host connection,
which in such a window is the remote's own host, so its paths name the same
filesystem the folder does.
---
 .../agentHost/agentHostSessionListStore.ts    | 27 +++++++-
 .../agentSessions/inFolderNamespace.test.ts   | 66 +++++++++++++++++++
 2 files changed, 92 insertions(+), 1 deletion(-)
 create mode 100644 src/vs/workbench/contrib/chat/test/browser/agentSessions/inFolderNamespace.test.ts

diff --git a/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionListStore.ts b/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionListStore.ts
index b191d0b07a842..e1d7e5468ae1d 100644
--- a/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionListStore.ts
+++ b/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionListStore.ts
@@ -6,6 +6,7 @@
 import { CancellationToken } from '../../../../../../base/common/cancellation.js';
 import { Emitter, Event } from '../../../../../../base/common/event.js';
 import { Disposable } from '../../../../../../base/common/lifecycle.js';
+import { Schemas } from '../../../../../../base/common/network.js';
 import { extUriBiasedIgnorePathCase } from '../../../../../../base/common/resources.js';
 import { URI } from '../../../../../../base/common/uri.js';
 import { AgentSession, type IAgentSessionMetadata } from '../../../../../../platform/agentHost/common/agentService.js';
@@ -23,6 +24,30 @@ export interface IAgentHostSessionListConnection {
 	dispatch(channel: string, action: SessionAction): void;
 }
 
+/**
+ * Reinterpret a working directory in the folder's namespace when the two
+ * describe the same filesystem under different schemes.
+ *
+ * An agent host reports working directories as paths on the machine it runs
+ * on, so a host running in a remote (a dev container, say) reports `file:`
+ * while the window's folder for that same directory is `vscode-remote:`.
+ * `isEqualOrParent` compares schemes before anything else, so the two can
+ * never match however identical their paths, and every session on the
+ * workspace folder is filtered out of the list.
+ *
+ * Only a `file:` directory against a folder with an authority is rewritten:
+ * a local window compares `file:` to `file:` and is untouched. The sessions
+ * being matched all come from this store's single host connection, which in
+ * such a window is the remote's own host, so its paths belong to the same
+ * filesystem the folder names.
+ */
+export function inFolderNamespace(directory: URI, folder: URI): URI {
+	if (directory.scheme !== Schemas.file || folder.scheme === Schemas.file || !folder.authority) {
+		return directory;
+	}
+	return folder.with({ path: directory.path, query: null, fragment: null });
+}
+
 /**
  * Provider-tagged backend session entry owned by the shared session-list store.
  */
@@ -398,7 +423,7 @@ export class AgentHostSessionListStore extends Disposable {
 
 	private _matchesAnyFolder(workingDirectories: readonly URI[], folders: readonly IWorkspaceFolder[]): boolean {
 		return workingDirectories.some(directory =>
-			folders.some(folder => extUriBiasedIgnorePathCase.isEqualOrParent(directory, folder.uri))
+			folders.some(folder => extUriBiasedIgnorePathCase.isEqualOrParent(inFolderNamespace(directory, folder.uri), folder.uri))
 		);
 	}
 
