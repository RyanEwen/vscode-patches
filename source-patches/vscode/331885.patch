From 572b3a275002b8c439f14a16829460a009c51346 Mon Sep 17 00:00:00 2001
From: Ryan Ewen <ryan.ewen@gmail.com>
Date: Thu, 20 Aug 2026 19:28:45 -0400
Subject: [PATCH 1/3] Replay the user's prompt without the host's added context

resolvePromptToContentBlocks sends a turn as several text blocks: the
user's prompt first, then whatever the host composed for the model, such
as the rendered attachment representations and the reference reminder.
The replay mapper joins every text block back into one string, so a turn
reconstructed from the SDK transcript presents that context as words the
user typed.

The result is visible in two places. A restored conversation shows the
ambient context inside the user's own message, which is why it appears
only on returning to a session and never while the turn is live. And a
session title seeded from the first turn inherits it, leaving sessions
named after the context blurb rather than the request.

Take the prompt block alone. The remaining blocks are host-composed and
regenerated every turn, so replaying them is wrong regardless of how
they render.
---
 .../node/claude/claudeReplayMapper.ts         |  8 +++++-
 .../test/node/claudeReplayMapper.test.ts      | 28 +++++++++++++++++++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/src/vs/platform/agentHost/node/claude/claudeReplayMapper.ts b/src/vs/platform/agentHost/node/claude/claudeReplayMapper.ts
index 5522564e786fd..4cbb8a6ffa30e 100644
--- a/src/vs/platform/agentHost/node/claude/claudeReplayMapper.ts
+++ b/src/vs/platform/agentHost/node/claude/claudeReplayMapper.ts
@@ -168,7 +168,13 @@ function parseUserMessage(msg: SessionMessage, timestamp: string | undefined): P
 	}
 	// Mixed or text-only: text wins — matches prior behavior where tool_results
 	// in a text-bearing envelope are dropped (they should already have been delivered).
-	return { kind: 'user-text', uuid: msg.uuid, text: textBlocks.map(b => b.text).join('\n'), timestamp };
+	//
+	// Only the first block is the user's prompt. `resolvePromptToContentBlocks`
+	// appends host-composed context after it (attachment representations and the
+	// reference reminder), which is ambient and regenerated every turn. Joining
+	// those back in replays them as words the user typed, so they surface in the
+	// restored transcript and in titles derived from the first turn.
+	return { kind: 'user-text', uuid: msg.uuid, text: textBlocks[0].text, timestamp };
 }
 
 function parseAssistantMessage(msg: SessionMessage, timestamp: string | undefined): ParsedSessionMessage | undefined {
