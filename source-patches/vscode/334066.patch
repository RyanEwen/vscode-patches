-					this._logService.info(`[ProtocolServer] Subscribe cancelled by client: ${params.channel}`);
+					this._logService.info(`[ProtocolServer] Subscribe cancelled: ${params.channel}`);
 					throw err;
 				}
 				if (err instanceof ProtocolError) {
