From 9db6d1870dd2e3298146b8148bfe461c751ffec2 Mon Sep 17 00:00:00 2001
From: Ryan Ewen <ryan.ewen@gmail.com>
Date: Fri, 4 Sep 2026 14:47:24 -0400
Subject: [PATCH 2/2] Answer a client tool invocation the host cannot run, and
 reuse a parked one

Two holes the admission path left open.

A `client_tool_invoked` arriving with no active turn was logged and dropped,
but the provider parks its deferred before firing the signal, so it waited
until session disposal. It is now failed back through the same completion
path the ownerless case uses.

`registerAndFire` replaced an entry that was still parked, unlike `register`,
which cancels the superseded deferred deliberately. Since the admission guard
suppresses the duplicate execution, only one response is ever produced and it
settled only the newer promise. A duplicate now awaits the parked request and
does not fire again, so the single response settles both callers.
---
 .../common/pendingRequestRegistry.ts          | 12 ++++++++-
 .../agentHost/node/agentSideEffects.ts        | 12 +++++++--
 .../common/pendingRequestRegistry.test.ts     | 26 +++++++++++++++++++
 .../test/node/agentSideEffects.test.ts        | 18 +++++++++++++
 4 files changed, 65 insertions(+), 3 deletions(-)

diff --git a/src/vs/platform/agentHost/common/pendingRequestRegistry.ts b/src/vs/platform/agentHost/common/pendingRequestRegistry.ts
index 6aca035e5341b..5fab48846eb82 100644
--- a/src/vs/platform/agentHost/common/pendingRequestRegistry.ts
+++ b/src/vs/platform/agentHost/common/pendingRequestRegistry.ts
@@ -30,13 +30,23 @@ export class PendingRequestRegistry<TResult, TMeta = void> {
 	 */
 	private readonly _earlyResults = new Map<string, TResult>();
 
-	/** Atomically park a deferred and optional metadata, then invoke `fire` to prevent synchronous responses racing registration. */
+	/**
+	 * Atomically park a deferred and optional metadata, then invoke `fire` so a
+	 * synchronous response cannot race registration.
+	 *
+	 * A duplicate call for a still-parked key awaits that request and does not
+	 * fire again, because only one response is produced and it must settle both.
+	 */
 	registerAndFire(key: string, fire: () => void, ...metadata: MetadataArgument<TMeta>): Promise<TResult> {
 		if (this._earlyResults.has(key)) {
 			const buffered = this._earlyResults.get(key) as TResult;
 			this._earlyResults.delete(key);
 			return Promise.resolve(buffered);
 		}
+		const existing = this._entries.get(key);
+		if (existing && !existing.deferred.isSettled) {
+			return existing.deferred.p;
+		}
 		const deferred = new DeferredPromise<TResult>();
 		this._entries.set(key, { deferred, metadata: metadata[0] as TMeta });
 		fire();
