		unpatched: /if\(!(\w+)\)\{(\w+)\(\w+\(\d+,null,(\w+)\),"toolUnavailable"\);return\}[\s\S]{0,700}?let (\w+);try\{let \w+=JSON\.parse\([\s\S]{0,220}?"invalidInput"\);return\}/,
